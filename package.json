{
  "name": "sightlab",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "storybook": "pnpm --filter @sightlab/storybook storybook",
    "storybook:build": "pnpm --filter @sightlab/storybook storybook:build"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "^15.5.0",
    "@sightlab/eslint": "workspace:*",
    "@sightlab/prettier": "workspace:*",
    "@sightlab/typescript": "workspace:*",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "prettier": "^3.0.0",
    "turbo": "^2.5.5",
    "typescript-eslint": "^8.0.0"
  }
}
