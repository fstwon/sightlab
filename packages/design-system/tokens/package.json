{
  "name": "@sightlab/tokens",
  "version": "0.0.0",
  "private": true,
  "description": "Sightlab 디자인 토큰 (SCSS 원본, CSS 변수 배포)",
  "scripts": {
    "build": "sass --no-source-map src:dist",
    "dev": "sass --no-source-map --watch src:dist",
    "lint:css": "stylelint \"src/**/*.scss\""
  },
  "devDependencies": {
    "@sightlab/stylelint-config": "workspace:*",
    "sass": "^1.108.2",
    "stylelint": "^17.16.0"
  },
  "files": [
    "dist",
    "src",
    "fonts",
    "index.d.ts"
  ],
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./dist/index.css"
    },
    "./sass": "./src/sass/_index.scss",
    "./sass/breakpoints": "./src/sass/_breakpoints.scss",
    "./*.css": "./dist/*.css",
    "./fonts/*": "./fonts/*"
  }
}
