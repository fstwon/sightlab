# apps/web/.env.local로 복사해 값을 채운다 (.env.local은 git에 올리지 않는다).
# 배포는 Vercel 환경 변수, CI는 GitHub secret에 같은 이름으로 넣는다. 빌드 전달 목록은 turbo.json build.env.

# Notion 통합(integration)의 내부 토큰. 권한은 "콘텐츠 읽기"만 준다.
NOTION_TOKEN=
# Notion 데이터 소스 id (Notes, Projects)
NOTION_NOTES_DATA_SOURCE_ID=
NOTION_PROJECTS_DATA_SOURCE_ID=
# Notion 웹훅 구독의 verification_token (서명 확인용). 구독 등록 때 /api/revalidate 로그에서 받는다.
# 로컬에서는 웹훅을 받을 수 없어 비워 둔다.
NOTION_WEBHOOK_SECRET=
