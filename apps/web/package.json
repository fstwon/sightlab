    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@notionhq/client": "^5.31.1",
    "@shikijs/rehype": "4.6.0",
    "@sightlab/icons": "workspace:*",
    "@sightlab/tokens": "workspace:*",
    "@sightlab/ui": "workspace:*",
    "@vercel/blob": "^2.9.0",
    "github-slugger": "2.0.0",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "10.1.0",
    "rehype-raw": "7.0.0",
    "rehype-slug": "6.0.0",
    "remark-gfm": "4.0.1",
    "server-only": "^0.0.1",
    "shiki": "4.6.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@sightlab/eslint-config": "workspace:*",
