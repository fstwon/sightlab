{
  "name": "@sightlab/web",
  "version": "0.0.0",
  "private": true,
  "description": "Sightlab 블로그 웹 앱 (Next.js App Router + FSD)",
  "type": "module",
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start --port 3000",
    "lint": "eslint .",
    "lint:css": "stylelint \"src/**/*.{css,scss}\"",
