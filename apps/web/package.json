    "@sightlab/typescript-config": "workspace:*",
    "@sightlab/vitest-config": "workspace:*",
    "@svgr/webpack": "^8.1.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "jsdom": "31.0.1",
