{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**", "storybook-static/**"],
      "env": [
        "NOTION_TOKEN",
        "NOTION_NOTES_DATA_SOURCE_ID",
        "NOTION_PROJECTS_DATA_SOURCE_ID",
        "VERCEL_PROJECT_PRODUCTION_URL",
        "BLOB_READ_WRITE_TOKEN"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "lint:css": {
      "dependsOn": ["^build"]
    },
    "typecheck": {},
    "test": {},
    "test:e2e": {
      "dependsOn": ["build"],
      "cache": false
    }
  },
  "globalDependencies": [".github/workflows/**"]
}
